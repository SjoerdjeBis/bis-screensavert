<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Video ligt onderop; afbeeldingen worden eroverheen ingefaded. Twee fotolagen, zodat
         foto X in foto Y overgaat zonder dat de video eronder doorschijnt. -->
    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/image_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/image_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.45"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="20dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/image_layer_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/image_background_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.45"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/image_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="20dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:background="@drawable/scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/caption_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/rubik_medium"
            android:letterSpacing="0.16"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="@color/boter"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/caption_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/fraunces_italic_semibold"
            android:maxWidth="640dp"
            android:shadowColor="#000000"
            android:shadowRadius="8"
            android:textColor="@color/room"
            android:textSize="25sp" />

        <TextView
            android:id="@+id/caption_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/rubik_medium"
            android:maxWidth="640dp"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#E6F6EFE0"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/caption_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="@font/rubik_regular"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="4"
            android:maxWidth="700dp"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#DDF6EFE0"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Muziek: neemt het scherm over zolang er iets speelt. -->
    <FrameLayout
        android:id="@+id/music_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@color/emaille"
        android:visibility="gone">

        <ImageView
            android:id="@+id/music_backdrop_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/music_backdrop_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_music" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="56dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/music_cover"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:background="@color/emaille_3"
                android:elevation="12dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/music_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/rubik_medium"
                    android:letterSpacing="0.16"
                    android:text="NU SPEELT"
                    android:textColor="@color/boter"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/music_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/fraunces_italic_semibold"
                    android:maxLines="2"
                    android:shadowColor="#000000"
                    android:shadowRadius="8"
                    android:textColor="@color/room"
                    android:textSize="40sp" />

                <TextView
                    android:id="@+id/music_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/rubik_medium"
                    android:shadowColor="#000000"
                    android:shadowRadius="6"
                    android:textColor="@color/room"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/music_album"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/rubik_regular"
                    android:shadowColor="#000000"
                    android:shadowRadius="6"
                    android:textColor="@color/room_dim"
                    android:textSize="14sp" />

                <ProgressBar
                    android:id="@+id/music_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="420dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="18dp"
                    android:max="1000"
                    android:progressDrawable="@drawable/progress_music" />

                <TextView
                    android:id="@+id/music_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/rubik_regular"
                    android:textColor="@color/room_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="28dp"
        android:fontFamily="@font/rubik_regular"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:shadowColor="#000000"
        android:shadowRadius="6"
        android:textColor="#80F6EFE0"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/sound_credit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="36dp"
        android:alpha="0"
        android:fontFamily="@font/rubik_medium"
        android:shadowColor="#000000"
        android:shadowRadius="8"
        android:textColor="#E6F6EFE0"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/fraunces_italic_semibold"
        android:text="@string/loading"
        android:textColor="#B0F6EFE0"
        android:textSize="20sp" />
</FrameLayout>
