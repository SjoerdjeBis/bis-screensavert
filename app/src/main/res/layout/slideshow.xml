<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Video ligt onderop; afbeeldingen worden eroverheen ingefaded. -->
    <SurfaceView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/image_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="@android:color/black">

        <ImageView
            android:id="@+id/image_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0.45"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:padding="24dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:background="@drawable/scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="64dp"
        android:paddingEnd="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/caption_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:maxWidth="620dp"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caption_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxWidth="620dp"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#E0E0E0"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/caption_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="6"
            android:maxWidth="620dp"
            android:shadowColor="#000000"
            android:shadowRadius="6"
            android:textColor="#D8D8D8"
            android:textSize="14sp" />
    </LinearLayout>

    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:format12Hour="HH:mm"
        android:format24Hour="HH:mm"
        android:shadowColor="#000000"
        android:shadowRadius="8"
        android:textColor="#F0FFFFFF"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/loading"
        android:textColor="#B0FFFFFF"
        android:textSize="18sp" />
</FrameLayout>
